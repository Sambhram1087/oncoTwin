# --- Local defaults (no external accounts needed) -------------------
DATABASE_URL=sqlite:///./oncotwin.db
JWT_SECRET=dev-secret-change-me-in-production
UPLOAD_DIR=./storage/uploads
CORS_ORIGINS=["http://localhost:3000"]

# --- Production swap: uncomment and fill in to use Supabase Postgres --
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# --- Production swap: Upstash Redis for Celery broker -----------------
# CELERY_BROKER_URL=redis://default:password@xxxx.upstash.io:6379
