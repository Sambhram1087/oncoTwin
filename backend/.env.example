# --- Local defaults (no external accounts needed) -------------------
DATABASE_URL=sqlite:///./oncotwin.db
JWT_SECRET=dev-secret-change-me-in-production
UPLOAD_DIR=./storage/uploads
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://onco-twin-six.vercel.app"]

# Render production values:
# CORS_ORIGINS=["https://onco-twin-six.vercel.app"]
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# SUPABASE_STORAGE_BUCKET=mri-uploads

# --- Production swap: uncomment and fill in to use Supabase Postgres --
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# --- Production swap: Upstash Redis for Celery broker -----------------
# CELERY_BROKER_URL=redis://default:password@xxxx.upstash.io:6379
